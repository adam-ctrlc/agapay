# EAS uses this file INSTEAD of .gitignore when packing the upload archive,
# so everything .gitignore covers has to be repeated here.

# The Laravel API ships to Vercel, not into the mobile build.
api/

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native artifacts and signing material
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
